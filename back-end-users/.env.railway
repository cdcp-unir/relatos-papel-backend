APP_NAME="${{RAILWAY_SERVICE_NAME}}"
DB_URL="jdbc:postgresql://${{db_users.PGHOST}}:5432/users_db"
DB_DRIVER="org.postgresql.Driver"
DB_USER="${{db_users.PGUSER}}"
DB_PASSWORD="${{db_users.PGPASSWORD}}"
REDIS_HOST="${{redis_db.REDISHOST}}"
REDIS_PORT="${{redis_db.REDISPORT}}"
EUREKA_URL="http://${{spring-cloud-eureka.RAILWAY_SERVICE_NAME}}:${{spring-cloud-eureka.PORT}}/eureka"
HOSTNAME="${{RAILWAY_SERVICE_NAME}}"
PORT="8080"
PROFILE="railway"