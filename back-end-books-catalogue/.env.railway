DB_URL="jdbc:postgresql://${{db_catalogue.PGHOST}}:5432/catalogue_db"
DB_DRIVER="org.postgresql.Driver"
DB_USER="${{db_catalogue.PGUSER}}"
DB_PASSWORD="${{db_catalogue.PGPASSWORD}}"
APP_NAME="${{RAILWAY_SERVICE_NAME}}"
EUREKA_URL="http://${{spring-cloud-eureka.RAILWAY_SERVICE_NAME}}:${{spring-cloud-eureka.PORT}}/eureka"
HOSTNAME="${{RAILWAY_SERVICE_NAME}}"
PORT="8080"
PROFILE="railway"
ELASTICSEARCH_HOST=${{elastic_db.HOST}}
ELASTICSEARCH_USER=${{elastic_db.USER}}
ELASTICSEARCH_PWD=${{elastic_db.PASSWORD}}